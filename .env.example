# Copy to .env for local runs. On Render, set these as environment variables.
# Never commit the real .env.

# --- Core ---
# Supabase: Project settings -> Database -> Connection string.
# Use the DIRECT connection or the SESSION pooler (port 5432), not the transaction pooler (6543).
DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres
ORG_ID=00000000-0000-0000-0000-000000000001

# Comma-separated list of frontend origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# true in production (HTTPS). Browsers accept Secure cookies on http://localhost too.
COOKIE_SECURE=true
SESSION_DAYS=7

# --- Supabase Storage (media stop-over) ---
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_SERVICE_KEY=service-role-key
STORAGE_BUCKET=intake
MAX_UPLOAD_MB=500

# --- FTP (public, files go to FTP_BASE_DIR/<slug>/) ---
# ftp | ftps | sftp
FTP_PROTOCOL=ftp
FTP_HOST=203.0.113.10
FTP_PORT=21
FTP_USER=vartmaan
FTP_PASSWORD=change-me
FTP_BASE_DIR=/Vartamaan_DND
# Everything outside this folder is read-only for Samvadia (enforced in code)
FTP_WRITE_ROOT=/Vartamaan_DND
FTP_PASSIVE=true
# SFTP only: the server's host key line, e.g. "ssh-ed25519 AAAAC3Nz..."
SFTP_HOST_KEY=
# SFTP only, testing only: accept any host key.
SFTP_ALLOW_ANY_HOST_KEY=false

# --- Octopus RSS feed: GET /feed/<FEED_SECRET>/feed.xml ---
FEED_SECRET=long-random-string
# Octopus server's public egress IP(s), comma-separated. Empty = no IP check (development only).
OCTOPUS_ALLOWED_IPS=
FEED_LINK_BASE=https://dorefinai.com/wire
# Which X-Forwarded-For entry is the client: 0 = the last one. Check feed_log IPs after the first deploy.
TRUSTED_PROXY_HOPS=0

# --- Owner console (Sentry People page): /owner/* routes ---
# Empty or shorter than 32 characters = every /owner route answers 404. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The same value goes into Sentry's server env as SAMVADIA_OWNER_KEY.
OWNER_API_KEY=

# --- Shadow mode: share of items with the AI panel hidden (clean training labels) ---
BLIND_RATE=0.10

# --- Slug ---
DEFAULT_STORY_TYPE=AV
SLUG_SUBJECT_MAX_WORDS=3

# --- WhatsApp Cloud API ---
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
GRAPH_API_VERSION=v21.0
WHATSAPP_MERGE_SECONDS=90

# --- Outlook / Microsoft 365 (Graph, Mail.Read limited to one mailbox) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=assignment.desk@example.com
MAIL_POLL_SECONDS=60
# Only mail received at or after this time (ISO with offset). Empty: the first fetch time is stored and used.
MAIL_FETCH_SINCE=

# --- FTP footage matcher (reads the newsroom district folders, never writes there) ---
FOOTAGE_WAIT_HOURS=4
FOOTAGE_CHECK_SECONDS=300
FOOTAGE_RECHECK_SECONDS=240
FOOTAGE_LIST_CACHE_SECONDS=60
FOOTAGE_BATCH=200
